NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required only for the private /admin view. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Notifications and private CRM access.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Local Ollama is available only on this computer by default.
# Keep false in cloud hosting until a protected cloud AI endpoint is connected.
AI_ANALYSIS_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
