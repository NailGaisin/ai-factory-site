{
  "name": "ai-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.0.0",
    "openai": "^7.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react-server-dom-webpack": "^19.3.0",
    "typescript": "^5.0.0",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
