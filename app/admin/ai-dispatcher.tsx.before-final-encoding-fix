"use client";

import { useEffect, useState } from "react";

type QueueItem = {
  id: string;
  name: string;
  company: string | null;
  contact: string;
  niche: string;
  status: string;
  dealAmount: number;
  aiScore: number;
  aiTemperature: string | null;
  aiRecommendedAction: string | null;
  priority: string;
  reason: string;
};

type DispatcherResponse = {
  ok: boolean;
  count: number;
  queue: QueueItem[];
  summary: {
    hot: number;
    money: number;
    urgent: number;
    followup: number;
    warm: number;
    cold: number;
  };
};

const priorityNames: Record<string, string> = {
  hot: "🔥 ГОРЯЧИЕ",
  money: "💰 ДЕНЬГИ",
  urgent: "Срочно",
  followup: "?? FOLLOW-UP",
  warm: "🟡 ТЁПЛЫЕ",
  cold: "❄️ ХОЛОДНЫЕ",
};

export default function AiDispatcher() {
  const [data, setData] = useState<DispatcherResponse | null>(null);
  const [loading, setLoading] = useState(true);

  async function load() {
    try {
      setLoading(true);

      const response = await fetch(
        "/api/admin/ai-dispatcher",
        { cache: "no-store" }
      );

      if (!response.ok) {
        throw new Error("AI dispatcher error");
      }

      const result = await response.json();
      setData(result);
    } catch (error) {
      console.error(error);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, []);

  if (loading) {
    return (
      <div className="dispatcherPanel">
        <div className="dispatcherTitle">
          AI-диспетчер
        </div>
        <div className="dispatcherLoading">
          АнализиСрочно очередь заСрочно...
        </div>
      </div>
    );
  }

  if (!data) {
    return (
      <div className="dispatcherPanel">
        Не удалось загрузить AI-диспетчер.
      </div>
    );
  }

  return (
    <section className="dispatcherPanel">
      <div className="dispatcherHead">
        <div>
          <h2>AI-диспетчер</h2>
          <p>
            Ком?? менедже???? нужно уделить внимание пСрочно сейчас
          </p>
        </div>

        <button
          className="button primary"
          onClick={load}
        >
          Обновить AI
        </button>
      </div>

      <div className="dispatcherStats">
        <div>
          <strong>{data.summary.hot}</strong>
          <span>Горячие</span>
        </div>

        <div>
          <strong>{data.summary.money}</strong>
          <span>Деньги</span>
        </div>

        <div>
          <strong>{data.summary.urgent}</strong>
          <span>Срочно</span>
        </div>

        <div>
          <strong>{data.summary.followup}</strong>
          <span>Follow-up</span>
        </div>

        <div>
          <strong>{data.count}</strong>
          <span>Всего</span>
        </div>
      </div>

      <div className="dispatcherQueue">
        {data.queue.map((lead, index) => (
          <article
            className="dispatcherLead"
            key={lead.id}
            role="button"
            tabIndex={0}
            onClick={() =>
              window.dispatchEvent(
                new CustomEvent("crm-focus-lead", {
                  detail: lead.id,
                })
              )
            }
            onKeyDown={(event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault()
                window.dispatchEvent(
                  new CustomEvent("crm-focus-lead", {
                    detail: lead.id,
                  })
                )
              }
            }}
          >
            <div className="dispatcherRank">
              #{index + 1}
            </div>

            <div className="dispatcherMain">
              <div className="dispatcherName">
                {lead.name}
              </div>

              <div className="dispatcherMeta">
                {lead.company || "Компани?? не указана"}
                {" · "}
                {lead.contact}
                {" · "}
                {lead.niche}
              </div>

              <div className="dispatcherReason">
                <b>
                  {priorityNames[lead.priority] ||
                    lead.priority}
                </b>
                {" — "}
                {lead.reason}
              </div>

              {lead.aiRecommendedAction && (
                <div className="dispatcherAction">
                  <span>Срочно Срочно:</span>
                  {lead.aiRecommendedAction}
                </div>
              )}
            </div>

            <div className="dispatcherMoney">
              {lead.dealAmount > 0
                ? `${lead.dealAmount.toLocaleString(
                    "ru-RU"
                  )} ?`
                : "—"}
            </div>

            <div className="dispatcherScore">
              AI {lead.aiScore}/100
            </div>
          </article>
        ))}
      </div>

      <style jsx>{`
        .dispatcherPanel {
          margin-top: 24px;
          padding: 24px;
          border: 1px solid #202938;
          border-radius: 18px;
          background: #0b1018;
        }

        .dispatcherHead {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 20px;
          margin-bottom: 22px;
        }

        .dispatcherHead h2 {
          margin: 0;
          font-size: 24px;
        }

        .dispatcherHead p {
          margin: 6px 0 0;
          color: #8b96a8;
        }

        .dispatcherStats {
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 12px;
          margin-bottom: 22px;
        }

        .dispatcherStats > div {
          padding: 16px;
          border: 1px solid #202938;
          border-radius: 14px;
          background: #080d14;
        }

        .dispatcherStats strong,
        .dispatcherStats span {
          display: block;
        }

        .dispatcherStats strong {
          font-size: 24px;
        }

        .dispatcherStats span {
          margin-top: 4px;
          color: #8b96a8;
          font-size: 13px;
        }

        .dispatcherQueue {
          display: grid;
          gap: 10px;
        }

        .dispatcherLead {
          display: grid;
          grid-template-columns: 46px minmax(0, 1fr) 140px 100px;
          gap: 16px;
          align-items: center;
          padding: 16px;
          border: 1px solid #202938;
          border-radius: 14px;
          background: #080d14;
        }

        .dispatcherRank {
          color: #8b96a8;
          font-weight: 700;
        }

        .dispatcherName {
          font-size: 16px;
          font-weight: 700;
        }

        .dispatcherMeta {
          margin-top: 4px;
          color: #8b96a8;
          font-size: 13px;
          overflow-wrap: anywhere;
        }

        .dispatcherReason {
          margin-top: 10px;
          font-size: 14px;
        }

        .dispatcherAction {
          margin-top: 8px;
          padding: 10px 12px;
          border-radius: 10px;
          background: #101722;
          color: #dce3ed;
          font-size: 13px;
        }

        .dispatcherAction span {
          display: block;
          margin-bottom: 4px;
          color: #8b96a8;
          font-size: 11px;
          text-transform: uppercase;
        }

        .dispatcherMoney {
          font-size: 15px;
          font-weight: 700;
          text-align: right;
        }

        .dispatcherScore {
          color: #8b96a8;
          text-align: right;
          font-size: 13px;
        }

        .dispatcherLoading {
          color: #8b96a8;
        }

        @media (max-width: 900px) {
          .dispatcherStats {
            grid-template-columns: repeat(2, 1fr);
          }

          .dispatcherLead {
            grid-template-columns: 36px minmax(0, 1fr);
          }

          .dispatcherMoney,
          .dispatcherScore {
            text-align: left;
            grid-column: 2;
          }
        }
      `}</style>
    </section>
  );
}
