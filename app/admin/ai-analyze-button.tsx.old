"use client";

import { useState } from "react";

type Analysis = {
  score: number;
  temperature: "hot" | "warm" | "cold";
  summary: string;
  needs: string;
  recommendedAction: string;
  firstReply: string;
};

type Props = {
  lead: {
    id: string;
    name: string;
    company?: string | null;
    contact: string;
    niche?: string | null;
  };
  initialAnalysis?: {
    score: number;
    temperature: "hot" | "warm" | "cold";
    summary?: string;
    needs?: string;
    recommendedAction?: string;
    firstReply?: string;
  } | null;
};

export function AiAnalyzeButton({ lead, initialAnalysis = null }: Props) {
  const [analysis, setAnalysis] = useState<Analysis | null>(
    initialAnalysis
      ? {
          score: initialAnalysis.score,
          temperature: initialAnalysis.temperature,
          summary: "",
          needs: "",
          recommendedAction: "",
          firstReply: "",
        }
      : null
  );
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [saved, setSaved] = useState(false);

  async function analyze() {
    setLoading(true);
    setError("");
    setSaved(false);

    try {
      const response = await fetch("/api/ai/analyze-lead", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ lead }),
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(data.error || "РћС€РёР±РєР° AI-Р°РЅР°Р»РёР·Р°");
      }

      const nextAnalysis = data.analysis as Analysis;
      setAnalysis(nextAnalysis);

      const saveResponse = await fetch(`/api/admin/leads/${lead.id}/ai`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          score: nextAnalysis.score,
          temperature: nextAnalysis.temperature,
        }),
      });

      const saveData = await saveResponse.json();

      if (!saveResponse.ok || !saveData.ok) {
        throw new Error(
          saveData.error || "AI-Р°РЅР°Р»РёР· РїРѕР»СѓС‡РµРЅ, РЅРѕ РЅРµ СЃРѕС…СЂР°РЅС‘РЅ РІ CRM"
        );
      }

      setSaved(true);
    } catch (err) {
      setError(err instanceof Error ? err.message : "РћС€РёР±РєР° AI-Р°РЅР°Р»РёР·Р°");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="admin-ai">
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 16,
          flexWrap: "wrap",
        }}
      >
        <div>
          <h3 style={{ margin: 0, fontSize: 20 }}>AI-Р°РЅР°Р»РёР· Р·Р°СЏРІРєРё</h3>
          <p style={{ margin: "6px 0 0", color: "#64748b" }}>
            Р›РѕРєР°Р»СЊРЅС‹Р№ Р°РЅР°Р»РёР· С‡РµСЂРµР· Qwen
          </p>
        </div>

        <button
          type="button"
          onClick={analyze}
          disabled={loading}
          style={{
            border: 0,
            borderRadius: 10,
            padding: "11px 18px",
            background: "#2563eb",
            color: "#fff",
            fontWeight: 700,
            cursor: loading ? "wait" : "pointer",
          }}
        >
          {loading ? "РђРЅР°Р»РёР·РёСЂСѓСЋ..." : "рџ¤– AI-Р°РЅР°Р»РёР·"}
        </button>
      </div>

      {error && (
        <div
          style={{
            marginTop: 16,
            padding: 12,
            borderRadius: 10,
            background: "#fee2e2",
            color: "#991b1b",
          }}
        >
          {error}
        </div>
      )}

      {analysis && (
        <div
          style={{
            marginTop: 20,
            display: "grid",
            gridTemplateColumns: "180px 1fr",
            gap: 20,
          }}
        >
          <div
            style={{
              padding: 18,
              borderRadius: 12,
              background: "#e2e8f0",
              textAlign: "center",
            }}
          >
            <div style={{ fontSize: 13, fontWeight: 700 }}>РћР¦Р•РќРљРђ</div>
            <div
              style={{
                fontSize: 42,
                fontWeight: 800,
                margin: "6px 0",
              }}
            >
              {analysis.score}
            </div>
            <div
              style={{
                fontSize: 16,
                fontWeight: 800,
                textTransform: "uppercase",
              }}
            >
              {analysis.temperature}
            </div>
            {saved && (
              <div
                style={{
                  marginTop: 8,
                  fontSize: 12,
                  fontWeight: 700,
                  color: "#166534",
                }}
              >
                РЎРѕС…СЂР°РЅРµРЅРѕ
              </div>
            )}
          </div>

          <div
            style={{
              display: "grid",
              gap: 14,
            }}
          >
            <div>
              <strong>Р РµР·СЋРјРµ</strong>
              <div>{analysis.summary}</div>
            </div>

            <div>
              <strong>РџРѕС‚СЂРµР±РЅРѕСЃС‚Рё РєР»РёРµРЅС‚Р°</strong>
              <div>{analysis.needs}</div>
            </div>

            <div>
              <strong>Р РµРєРѕРјРµРЅРґСѓРµРјРѕРµ РґРµР№СЃС‚РІРёРµ</strong>
              <div>{analysis.recommendedAction}</div>
            </div>

            <div>
              <strong>РџРµСЂРІС‹Р№ РѕС‚РІРµС‚ РєР»РёРµРЅС‚Сѓ</strong>
              <div>{analysis.firstReply}</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

