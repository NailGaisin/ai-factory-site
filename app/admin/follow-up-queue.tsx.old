"use client";

import { useEffect, useMemo, useState } from "react";

type ContactResult =
  | "not_contacted"
  | "contacted"
  | "thinking"
  | "won"
  | "lost"
  | null;

type Lead = {
  id: string;
  name: string;
  company: string;
  contact: string;
  createdAt: string;
  aiScore: number | null;
  aiTemperature: "hot" | "warm" | "cold" | null;
  aiRecommendedAction: string | null;
  contactResult: ContactResult;
};

type Props = {
  leads: Lead[];
};

function formatElapsed(ms: number) {
  const totalMinutes = Math.max(
    0,
    Math.floor(ms / 60000)
  );

  const days = Math.floor(
    totalMinutes / 1440
  );

  const hours = Math.floor(
    (totalMinutes % 1440) / 60
  );

  const minutes = totalMinutes % 60;

  if (days > 0) {
    return `${days}д ${hours}ч`;
  }

  if (hours > 0) {
    return `${hours}ч ${minutes}м`;
  }

  return `${minutes}м`;
}

export function FollowUpQueue({ leads }: Props) {
  const [mounted, setMounted] = useState(false);
  const [now, setNow] = useState(0);
  const [savingId, setSavingId] = useState<string | null>(
    null
  );

  useEffect(() => {
    setMounted(true);
    setNow(Date.now());

    const interval = window.setInterval(() => {
      setNow(Date.now());
    }, 1000);

    return () => {
      window.clearInterval(interval);
    };
  }, []);

  const followUps = useMemo(() => {
    return leads
      .filter(
        (lead) =>
          lead.contactResult === "thinking"
      )
      .map((lead) => {
        const createdTime =
          new Date(lead.createdAt).getTime();

        return {
          ...lead,
          elapsed: mounted
            ? Math.max(0, now - createdTime)
            : 0,
        };
      })
      .sort((a, b) => {
        const scoreA = a.aiScore ?? -1;
        const scoreB = b.aiScore ?? -1;

        if (scoreA !== scoreB) {
          return scoreB - scoreA;
        }

        return b.elapsed - a.elapsed;
      })
      .slice(0, 10);
  }, [leads, mounted, now]);

  async function updateLead(
    leadId: string,
    contactResult:
      | "contacted"
      | "won"
      | "lost"
  ) {
    setSavingId(leadId);

    try {
      const response = await fetch(
        `/api/admin/leads/${encodeURIComponent(
          leadId
        )}`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            contact_result: contactResult,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.error ??
            "Не удалось обновить заявку"
        );
      }

      window.location.reload();
    } catch (error) {
      console.error(error);

      alert(
        error instanceof Error
          ? error.message
          : "Ошибка обновления заявки"
      );
    } finally {
      setSavingId(null);
    }
  }

  return (
    <section
      style={{
        marginBottom: 24,
        padding: 18,
        border: "1px solid #ddd6fe",
        borderRadius: 14,
        background: "#faf5ff",
      }}
    >
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 12,
          marginBottom: 14,
        }}
      >
        <div>
          <div
            style={{
              fontSize: 18,
              fontWeight: 800,
            }}
          >
            Follow-up → Клиенты думают
          </div>

          <div
            style={{
              marginTop: 4,
              fontSize: 13,
              color: "#6b21a8",
            }}
          >
            Заявки после контакта, которые ещё
            не закрыты
          </div>
        </div>

        <div
          style={{
            minWidth: 32,
            height: 32,
            padding: "0 10px",
            borderRadius: 999,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            background: "#ede9fe",
            color: "#6b21a8",
            fontWeight: 800,
          }}
        >
          {followUps.length}
        </div>
      </div>

      {followUps.length === 0 ? (
        <div
          style={{
            padding: 14,
            borderRadius: 10,
            background: "#fff",
            color: "#6b7280",
            fontSize: 14,
          }}
        >
          Клиентов на follow-up сейчас нет.
        </div>
      ) : (
        <div
          style={{
            display: "grid",
            gap: 10,
          }}
        >
          {followUps.map((lead) => {
            const priority =
              lead.aiTemperature === "hot"
                ? "🔥 HOT"
                : lead.aiTemperature === "warm"
                  ? "🟡 WARM"
                  : "⚪ COLD";

            const saving =
              savingId === lead.id;

            return (
              <div
                key={lead.id}
                style={{
                  padding: 14,
                  border: "1px solid #e9d5ff",
                  borderRadius: 12,
                  background: "#fff",
                }}
              >
                <div
                  style={{
                    display: "flex",
                    justifyContent:
                      "space-between",
                    alignItems: "flex-start",
                    gap: 12,
                  }}
                >
                  <div>
                    <div
                      style={{
                        fontSize: 16,
                        fontWeight: 800,
                      }}
                    >
                      {lead.name}
                    </div>

                    <div
                      style={{
                        marginTop: 3,
                        color: "#4b5563",
                        fontSize: 14,
                      }}
                    >
                      {lead.company}
                    </div>

                    <div
                      style={{
                        marginTop: 3,
                        color: "#6b7280",
                        fontSize: 13,
                      }}
                    >
                      {lead.contact}
                    </div>
                  </div>

                  <div
                    style={{
                      textAlign: "right",
                      whiteSpace: "nowrap",
                    }}
                  >
                    <div
                      style={{
                        fontWeight: 800,
                      }}
                    >
                      {priority}
                    </div>

                    {lead.aiScore !== null && (
                      <div
                        style={{
                          marginTop: 3,
                          fontSize: 12,
                          color: "#6b7280",
                        }}
                      >
                        AI: {lead.aiScore}/100
                      </div>
                    )}

                    <div
                      style={{
                        marginTop: 3,
                        fontSize: 12,
                        color: "#7e22ce",
                      }}
                    >
                      {formatElapsed(
                        lead.elapsed
                      )}
                    </div>
                  </div>
                </div>

                {lead.aiRecommendedAction && (
                  <div
                    style={{
                      marginTop: 10,
                      padding: 10,
                      borderRadius: 8,
                      background: "#faf5ff",
                      fontSize: 13,
                    }}
                  >
                    <strong>
                      AI рекомендует:
                    </strong>{" "}
                    {lead.aiRecommendedAction}
                  </div>
                )}

                <div
                  style={{
                    display: "flex",
                    flexWrap: "wrap",
                    gap: 8,
                    marginTop: 12,
                  }}
                >
                  <button
                    type="button"
                    disabled={saving}
                    onClick={() =>
                      updateLead(
                        lead.id,
                        "contacted"
                      )
                    }
                    style={{
                      border:
                        "1px solid #93c5fd",
                      background: "#eff6ff",
                      color: "#1d4ed8",
                      borderRadius: 8,
                      padding: "8px 12px",
                      fontWeight: 700,
                      cursor: saving
                        ? "default"
                        : "pointer",
                    }}
                  >
                    {saving
                      ? "!>E@0=ON..."
                      : "� !2O70;8AL A=>20"}
                  </button>

                  <button
                    type="button"
                    disabled={saving}
                    onClick={() =>
                      updateLead(
                        lead.id,
                        "won"
                      )
                    }
                    style={{
                      border:
                        "1px solid #86efac",
                      background: "#f0fdf4",
                      color: "#166534",
                      borderRadius: 8,
                      padding: "8px 12px",
                      fontWeight: 700,
                      cursor: saving
                        ? "default"
                        : "pointer",
                    }}
                  >
                    ✓ Закрыли
                  </button>

                  <button
                    type="button"
                    disabled={saving}
                    onClick={() =>
                      updateLead(
                        lead.id,
                        "lost"
                      )
                    }
                    style={{
                      border:
                        "1px solid #d1d5db",
                      background: "#f9fafb",
                      color: "#4b5563",
                      borderRadius: 8,
                      padding: "8px 12px",
                      fontWeight: 700,
                      cursor: saving
                        ? "default"
                        : "pointer",
                    }}
                  >
                    ✕ Отказ
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}