"use client";

import { useEffect } from "react";
import { useRouter } from "next/navigation";

type PriorityLead = {
  id: string;
  name?: string | null;
  contact?: string | null;
  aiScore: number | null;
  aiTemperature:
    | "hot"
    | "warm"
    | "cold"
    | null;
};

export function AiPriorityQueue({
  leads,
}: {
  leads: PriorityLead[];
}) {
  const router = useRouter();

  useEffect(() => {
    function refreshQueue() {
      router.refresh();
    }

    window.addEventListener(
      "ai-analysis-updated",
      refreshQueue
    );

    return () => {
      window.removeEventListener(
        "ai-analysis-updated",
        refreshQueue
      );
    };
  }, [router]);

  const hot = leads
    .filter((lead) => lead.aiTemperature === "hot")
    .sort((a, b) => (b.aiScore ?? -1) - (a.aiScore ?? -1));

  const warm = leads
    .filter((lead) => lead.aiTemperature === "warm")
    .sort((a, b) => (b.aiScore ?? -1) - (a.aiScore ?? -1));

  const cold = leads
    .filter((lead) => lead.aiTemperature === "cold")
    .sort((a, b) => (b.aiScore ?? -1) - (a.aiScore ?? -1));

  const groups = [
    {
      title: "🔥 HOT — звонить сейчас",
      leads: hot,
      background: "#fef2f2",
      border: "#fecaca",
      badge: "#991b1b",
    },
    {
      title: "🟡 WARM — обработать сегодня",
      leads: warm,
      background: "#fffbeb",
      border: "#fde68a",
      badge: "#92400e",
    },
    {
      title: "🔵 COLD — в резерв",
      leads: cold,
      background: "#eff6ff",
      border: "#bfdbfe",
      badge: "#1e40af",
    },
  ];

  return (
    <div
      style={{
        display: "grid",
        gap: 14,
        marginBottom: 32,
      }}
    >
      {groups.map((group) => (
        <div
          key={group.title}
          style={{
            background: group.background,
            border: `1px solid ${group.border}`,
            borderRadius: 14,
            padding: "16px 18px",
          }}
        >
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              gap: 12,
              marginBottom: group.leads.length ? 12 : 0,
            }}
          >
            <strong
              style={{
                color: "#111827",
                fontSize: 16,
              }}
            >
              {group.title}
            </strong>

            <span
              style={{
                background: group.badge,
                color: "#ffffff",
                borderRadius: 999,
                padding: "4px 10px",
                fontSize: 12,
                fontWeight: 800,
              }}
            >
              {group.leads.length}
            </span>
          </div>

          {group.leads.length > 0 && (
            <div
              style={{
                display: "grid",
                gap: 8,
              }}
            >
              {group.leads.slice(0, 5).map((lead) => (
                <div
                  key={lead.id}
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                    gap: 12,
                    background: "#ffffff",
                    borderRadius: 9,
                    padding: "10px 12px",
                  }}
                >
                  <div
                    style={{
                      minWidth: 0,
                      color: "#111827",
                    }}
                  >
                    <strong>
                      {lead.name || "Без имени"}
                    </strong>

                    {lead.contact && (
                      <span
                        style={{
                          marginLeft: 10,
                          color: "#64748b",
                          fontSize: 13,
                        }}
                      >
                        {lead.contact}
                      </span>
                    )}
                  </div>

                  <span
                    style={{
                      flexShrink: 0,
                      fontWeight: 800,
                      color: group.badge,
                    }}
                  >
                    {lead.aiScore ?? "—"}/100
                  </span>
                </div>
              ))}

              {group.leads.length > 5 && (
                <div
                  style={{
                    color: "#64748b",
                    fontSize: 12,
                    paddingTop: 3,
                  }}
                >
                  Ещё заявок: {group.leads.length - 5}
                </div>
              )}
            </div>
          )}

          {group.leads.length === 0 && (
            <div
              style={{
                color: "#64748b",
                fontSize: 13,
              }}
            >
              Заявок нет
            </div>
          )}
        </div>
      ))}
    </div>
  );
}